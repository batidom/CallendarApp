generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  surname      String?
  username     String   @unique
  timezone     String?
  emailVerified Boolean @default(false) @map("email_verified")
  // Two-factor authentication. twoFactorMethod is a discriminator ('totp' or
  // 'email_otp') so twoFactorSecret alone (only ever set for 'totp') can't
  // tell the two apart. twoFactorSecret is AES-256-GCM encrypted at rest
  // (see totp-crypto.util.ts) since, unlike a password, it must be
  // recoverable in its original form to compute a comparison code.
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorMethod  String? @map("two_factor_method")
  twoFactorSecret  String? @map("two_factor_secret")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  // Set when the account is deleted — the row itself is kept (never hard
  // deleted) as an anonymized tombstone so foreign keys from OTHER users'
  // data (an event they still see because someone else invited them, a file
  // this user uploaded onto someone else's event) keep resolving. All
  // directly-identifying fields are scrubbed at the same time — see
  // AuthService.deleteAccount().
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  oauthIntegrations OAuthIntegration[]
  events            Event[]

  sentFriendRequests     Friendship[]  @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]  @relation("FriendshipAddressee")
  groups                 Group[]
  groupMemberships       GroupMember[]
  sentEventInvites       EventInvite[] @relation("EventInviteInviter")
  receivedEventInvites   EventInvite[] @relation("EventInviteInvitee")
  uploadedAttachments    Attachment[]
  refreshTokens          RefreshToken[]
  emailVerificationCode  EmailVerificationCode?
  passwordResetCode      PasswordResetCode?
  receivedNotifications  Notification[] @relation("NotificationRecipient")
  actedNotifications     Notification[] @relation("NotificationActor")
  twoFactorBackupCodes   TwoFactorBackupCode[]
  pendingTwoFactorLogins PendingTwoFactorLogin[]
  emailTwoFactorCode     EmailTwoFactorCode?

  @@map("users")
}

// A single pending verification code per user (a fresh register or resend
// simply overwrites this row) — the code itself is never stored in plain
// text, only its hash, same pattern as RefreshToken. attempts guards against
// online brute-forcing of the 6-digit code within its expiry window: after
// MAX_VERIFICATION_ATTEMPTS wrong guesses the row is dead and the user must
// request a new code rather than keep guessing the old one.
model EmailVerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_codes")
}

// Same shape and threat model as EmailVerificationCode, kept as a separate
// table (rather than reusing it) so a pending email-verification code and a
// pending password-reset code don't clobber each other if both are
// requested around the same time.
model PasswordResetCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}

// A friend relationship, modeled as a single directed row from requester to
// addressee. Two users are friends once status is accepted; either side can
// then read the row regardless of who originally sent it.
model Friendship {
  id           String           @id @default(uuid()) @db.Uuid
  requesterId  String           @map("requester_id") @db.Uuid
  addresseeId  String           @map("addressee_id") @db.Uuid
  status       FriendshipStatus @default(pending)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  respondedAt  DateTime?        @map("responded_at") @db.Timestamptz

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

enum FriendshipStatus {
  pending
  accepted
}

// An owner-scoped contact grouping (e.g. "Family", "Board game night") used
// as a bulk-invite shortcut. Not a shared/collaborative entity — only the
// owner manages membership, and members must already be the owner's friends.
model Group {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  // How many times this group has been used to invite people to an event —
  // drives the "most frequently used first" ordering in the invite picker
  // (see GroupsService.listGroups). Friends don't need an equivalent column:
  // their usage is just derived from counting existing EventInvite rows.
  usageCount Int @default(0) @map("usage_count")

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @map("group_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

// A long-lived opaque credential ("Keep me signed in" on the client) that
// lets the client silently mint a new short-lived access token without the
// user re-entering their password — otherwise a desktop tray instance left
// running for longer than JWT_EXPIRES_IN would silently start failing every
// backend call (sync, assistant chat) once its access token expired, with
// no way back short of a manual re-login. Only the SHA-256 hash is stored,
// never the raw token, so a DB read alone can't be replayed as a session.
// Rotated on every use — but unlike a hard delete, the old row is kept with
// revokedAt set rather than removed, specifically so AuthService.refresh()
// can tell "expired/unknown token" (nothing to do) apart from "a token that
// was already rotated away is being presented again" (a strong signal of
// theft — a legitimate client always uses the newest token it has), and
// respond to the latter by revoking every one of that user's sessions.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Single-use recovery codes issued once, at the moment 2FA is successfully
// enabled (see AuthService.enableTotp()). Hashed with bcrypt (same
// SALT_ROUNDS as passwords) rather than the fast SHA-256 used for
// RefreshToken/verification codes: unlike those high-entropy
// machine-generated bearer tokens, a leaked backup code is directly usable
// by a human exactly like a password would be, so it gets the same
// slow-hash protection. Not unique-per-user — the whole batch issued at
// once coexists as separate rows, consumed (usedAt set, not deleted) one at
// a time, so a user can later see how many are left.
model TwoFactorBackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

// The bridge between "password verified" and "fully logged in" once a user
// has 2FA enabled — see AuthService.login()/verifyTwoFactorLogin(). Combines
// RefreshToken's pattern (opaque randomBytes token, only its hash persisted,
// @unique, short-lived, deleted on consume) with EmailVerificationCode's
// pattern (attempts counter capping brute-force of the 6-digit code). Not
// unique-per-user: concurrent login attempts from different devices each
// get their own row. method mirrors User.twoFactorMethod at the moment this
// row was created — for 'totp' the code is checked against the user's
// stored secret; for 'email_otp' it's checked against EmailTwoFactorCode,
// which login() (re)issues in lockstep with this row.
model PendingTwoFactorLogin {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  method    String
  tokenHash String   @unique @map("token_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pending_two_factor_logins")
}

// A one-time code emailed to the account's own (already-verified) address,
// used wherever the email-OTP method needs to prove "you still have access
// to this inbox right now" — enabling it, disabling it, or completing an
// email-OTP login (see AuthService.issueEmailTwoFactorCode/
// verifyEmailTwoFactorCode). Same single-pending-code-per-user shape as
// EmailVerificationCode/PasswordResetCode (a fresh request just overwrites
// it), kept as its own table for the same clobbering-isolation reasoning as
// those two. Unlike its siblings, it has no `attempts` counter of its own —
// every caller that reaches this table is already behind the IP-based
// AUTH_THROTTLE (see auth.controller.ts), which didn't exist yet when the
// older two tables were designed.
model EmailTwoFactorCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_two_factor_codes")
}

model OAuthIntegration {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  provider     String
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  syncToken    String?  @map("sync_token")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_integrations")
}

// A single unified "task": a pure backlog idea (no assignedDate, no
// startTime), a loose item for a specific day (assignedDate set, startTime
// still null), or a fully timed event (startTime/endTime set — the day is
// implied by startTime, so assignedDate is only meaningful when startTime
// is null). Repeat/reminders only apply once a specific time is set.
model Event {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  title         String
  description   String?
  location      String?
  assignedDate  DateTime? @map("assigned_date") @db.Date
  startTime     DateTime? @map("start_time") @db.Timestamptz
  endTime       DateTime? @map("end_time") @db.Timestamptz
  isAllDay      Boolean   @default(false) @map("is_all_day")
  rrule         String?
  googleEventId String?   @map("google_event_id")
  // User-chosen position within the "Someday" backlog panel (drag-to-reorder)
  // — only meaningful for backlog items (no assignedDate/startTime); null
  // means "never manually ordered", and the client falls back to createdAt
  // for those. Irrelevant to timed/loose events, which are always ordered by
  // their own date/time instead.
  backlogOrder  Int?      @map("backlog_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Recurrence exceptions ("this event only" edits/deletes on one occurrence
  // of a recurring series), modeled the way iCalendar does it:
  //  - Editing one occurrence creates a standalone Event row (no rrule of
  //    its own) with recurrenceOverrideOf/originalOccurrenceStart pointing
  //    back at the series it came from and which slot it replaces.
  //  - Deleting one occurrence (or the slot an override took over) just adds
  //    its original start instant to the master's excludedOccurrences list,
  //    so the client's local expansion of the series skips generating it.
  // excludedOccurrences is only meaningful on a recurring master (a
  // comma-separated list of ISO8601 instants); it's opaque to the backend,
  // same as rrule.
  recurrenceOverrideOf   String?   @map("recurrence_override_of") @db.Uuid
  originalOccurrenceStart DateTime? @map("original_occurrence_start") @db.Timestamptz
  excludedOccurrences    String?   @map("excluded_occurrences")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders       EventReminder[]
  invites         EventInvite[]
  attachments     Attachment[]
  overrideOfEvent Event?           @relation("EventRecurrenceOverride", fields: [recurrenceOverrideOf], references: [id], onDelete: Cascade)
  overrides       Event[]          @relation("EventRecurrenceOverride")
  notifications   Notification[]

  @@index([userId, startTime, endTime])
  @@index([userId, assignedDate])
  @@index([recurrenceOverrideOf])
  @@map("events")
}

// Metadata for a file stored on disk under a per-event folder (see
// AttachmentsService) — the row is the source of truth for access control;
// the actual bytes are just addressed by storagePath.
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  filename     String
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storagePath  String   @map("storage_path")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("attachments")
}

// One row per invited user (groups are expanded to member rows at invite
// time rather than resolved dynamically, so membership changes afterward
// don't retroactively add/remove someone from an event they were or weren't
// invited to).
model EventInvite {
  id             String            @id @default(uuid()) @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  invitedUserId  String            @map("invited_user_id") @db.Uuid
  invitedById    String            @map("invited_by_id") @db.Uuid
  status         EventInviteStatus @default(pending)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  respondedAt    DateTime?         @map("responded_at") @db.Timestamptz

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedUser User @relation("EventInviteInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User @relation("EventInviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([eventId, invitedUserId])
  @@index([invitedUserId, status])
  @@map("event_invites")
}

// Generic, minimal, in-app-only notification — no push/email delivery.
// "Read" state is intentionally NOT tracked here: like the client's local
// reminder popups, "seen" is just a client-side timestamp cutover, so the
// same server row never needs a per-user read flag. type is a free-form
// discriminator ('left_event', 'schedule_changed', 'location_changed' today)
// so future notification kinds reuse this table instead of each getting
// their own. eventTitle is a snapshot
// (Event rows are hard-deleted, unlike User, so the live title wouldn't
// survive the event being deleted later) — eventId itself is kept too, but
// only for "tap to open", and is nulled if the event is gone.
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  actorId    String    @map("actor_id") @db.Uuid
  eventId    String?   @map("event_id") @db.Uuid
  eventTitle String?   @map("event_title")
  // Free-form "what it was" / "what it became" snapshot, meaning depends on
  // `type` (ISO datetime for date_changed/time_changed, raw text for
  // location_changed/description_changed) — lets the client render an exact
  // diff instead of just "something changed".
  oldValue   String?   @map("old_value")
  newValue   String?   @map("new_value")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user  User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("notifications")
}

enum EventInviteStatus {
  pending
  accepted
  declined
}

model EventReminder {
  id            String @id @default(uuid()) @db.Uuid
  eventId       String @map("event_id") @db.Uuid
  minutesBefore Int    @map("minutes_before")
  type          String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_reminders")
}
