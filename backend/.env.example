DATABASE_URL="postgresql://calendar:calendar@localhost:5432/calendar_app?schema=public"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Required: base64-encoded 32-byte key used to encrypt TOTP (2FA) secrets at
# rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

PORT=3000

# Comma-separated list of allowed browser origins (e.g. a future web client).
# The Windows/Android clients aren't browsers so this doesn't affect them.
# Leave unset in local dev to allow any origin.
ALLOWED_ORIGINS=

# --- Email (Gmail API) ---
# Required: registration and password reset send a verification code by
# email, so these must be set before either will work. Run `npm run
# gmail:auth` for a one-time OAuth flow that prints GOOGLE_GMAIL_REFRESH_TOKEN
# for you to paste in below.
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=

# --- AI assistant (optional) ---
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:14b"
WHISPER_URL="http://127.0.0.1:8081"
