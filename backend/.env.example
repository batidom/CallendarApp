DATABASE_URL="postgresql://calendar:calendar@localhost:5432/calendar_app?schema=public"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

PORT=3000

# --- Email (Gmail API) ---
# Required: registration and password reset send a verification code by
# email, so these must be set before either will work. Run `npm run
# gmail:auth` for a one-time OAuth flow that prints GOOGLE_GMAIL_REFRESH_TOKEN
# for you to paste in below.
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=

# --- AI assistant (optional) ---
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:14b"
WHISPER_URL="http://127.0.0.1:8081"
